Screen {
    background: $background;
}

/* Header: one line, like a breadcrumb bar */

#header {
    height: 1;
    padding: 0 2;
    margin-bottom: 1;
}

#brand {
    width: auto;
    color: $primary;
    text-style: bold;
    margin-right: 1;
}

#crumb {
    width: 1fr;
}

#connection {
    width: auto;
    margin-right: 2;
}

#connection.ok {
    color: $success;
}

#connection.error {
    color: $error;
}

#clock {
    width: auto;
    color: $text-muted;
}

#body {
    height: 1fr;
    padding: 0 1;
}

/* Panels: grey rounded border, blue when focus is inside */

.panel {
    border: round #3E4451;
    border-title-color: #7F848E;
    border-title-align: right;
    border-title-style: none;
    background: $background;
    padding: 0 1;
}

.panel:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

Sidebar {
    width: 22;
    height: 1fr;
    margin-right: 1;
    border: round #3E4451;
    border-title-color: $primary;
    border-title-align: left;
    border-title-style: bold;
    background: $background;
    padding: 1 0;
}

Sidebar:focus {
    border: round $primary;
    background-tint: transparent;
}

Sidebar > ListItem {
    padding: 0 2;
    height: 1;
    margin-bottom: 1;
    background: transparent;
}

#pages {
    width: 1fr;
    height: 1fr;
}

.page {
    height: 1fr;
}

.box {
    height: auto;
    margin-bottom: 1;
}

.section-title {
    color: $primary;
    text-style: bold;
    height: 1;
    margin: 1 0 1 0;
}

.message {
    height: auto;
    color: #7F848E;
    margin: 1 0;
}

DataTable {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    background: $background;
    color: #7F848E;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #2C313A;
    color: $foreground;
    text-style: none;
}

DataTable:focus > .datatable--cursor {
    background: #2C3E55;
    color: #E6EDF3;
}

DataTable > .datatable--hover {
    background: #262A31;
}

#job-search {
    margin-top: 1;
    border: tall #3E4451;
    background: $surface;
}

#job-search:focus {
    border: tall $primary;
}

/* Overview */

#recent-box {
    height: 1fr;
}

/* Cluster */

#placement-table {
    height: auto;
}

#queue-table {
    height: auto;
    max-height: 10;
}

/* Projects */

#projects-table {
    height: auto;
    max-height: 12;
}

#usage-table {
    height: 1fr;
}

/* Storage */

#storage-usage {
    margin-top: 1;
}

/* Job details / logs: full-screen panels */

JobDetailsScreen, LogScreen {
    padding: 1 1 0 1;
}

#details, #log-panel {
    height: 1fr;
}

#details-title {
    margin-top: 1;
}

#details-columns {
    height: auto;
}

#details-columns > .box {
    width: 1fr;
}

Log {
    height: 1fr;
    background: $background;
}

/* Dialogs */

ConfirmCancelScreen, HelpScreen {
    align: center middle;
    background: $background 60%;
}

#dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    border: round $primary;
    border-title-color: $primary;
}

#dialog.danger {
    border: round $error;
    border-title-color: $error;
}

#password {
    margin-top: 1;
    border: tall $primary;
    background: $surface;
}

#dialog-buttons {
    height: auto;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin-left: 2;
}

CalendarScreen {
    align: center middle;
    background: $background 60%;
}

#calendar {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $primary;
    border-title-color: $primary;
}

#calendar-help {
    text-align: center;
}

#commands {
    width: 90%;
    height: 80%;
    padding: 1 2;
    border: round $primary;
    border-title-color: $primary;
}

#commands-text {
    height: 1fr;
    background: $surface;
    border: none;
}

CommandsScreen, DeleteConfirmScreen {
    align: center middle;
    background: $background 60%;
}

#delete-word {
    margin: 1 0;
    border: tall $error;
    background: $surface;
}

#help {
    width: 60;
    height: auto;
    max-height: 90%;
    padding: 1 2;
}
